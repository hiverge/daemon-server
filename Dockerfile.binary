# Dockerfile for daemon-server binary container
# This creates a minimal image containing just the binary for use as an init container
#
# Build: docker build -f Dockerfile.binary -t your-registry/daemon-server-binary:v1 .
# Usage: Used as init container to inject binary into user's sandbox pods

FROM scratch

# Copy the pre-built binary
COPY dist/daemon-server /daemon-server

# This image is meant to be used as init container source
# Example usage in pod:
# initContainers:
# - name: inject-daemon-server
#   image: your-registry/daemon-server-binary:v1
#   command: ["cp", "/daemon-server", "/shared/bin/"]
#   volumeMounts:
#   - name: shared-bin
#     mountPath: /shared/bin
